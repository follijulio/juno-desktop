#!/usr/bin/env bash
set -euo pipefail
umask 077
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/../lib/runtime.sh"
source "$SCRIPT_DIR/../lib/wallpaper.sh"
juno_require hyprlock flock pgrep
juno_require_session
juno_prepare_runtime

lock_file=$JUNO_RUNTIME_DIR/lock-$(juno_session_key).lock
juno_safe_output "$lock_file"
exec 8>"$lock_file"
if ! flock -n 8; then
    exit 0
fi
if juno_is_running hyprlock; then
    exit 0
fi

# Generate a private configuration without evaluating catalog data. Paths with
# Hyprlang metacharacters fall back to solid paper instead of entering config.
template=$JUNO_CONFIG_HOME/hypr/hyprlock.conf
runtime_config=$JUNO_RUNTIME_DIR/hyprlock-$(juno_session_key).conf
juno_safe_output "$runtime_config"
wallpaper=''
if command -v jq >/dev/null 2>&1 && command -v realpath >/dev/null 2>&1 && juno_wallpaper_catalog; then
    if selected=$(juno_wallpaper_current); then
        wallpaper=$(juno_wallpaper_file "$selected") || wallpaper=''
    fi
    # Arch's hyprgraphics currently lacks the optional AVIF decoder, although
    # awww supports it. Keep locking independent of that image codec.
    if [[ $wallpaper == *.avif ]]; then
        selected=$(jq -er '.default' "$JUNO_WALLPAPER_CATALOG") || selected=''
        wallpaper=$(juno_wallpaper_file "$selected") || wallpaper=''
        [[ $wallpaper != *.avif ]] || wallpaper=''
    fi
fi
case "$wallpaper" in
    *'$'*|*'#'*|*'{'*|*'}'*|*'='*|*\\*|*$'\n'*|*$'\r'*) wallpaper='' ;;
esac
if [[ ! -f $template || ! -r $template ]]; then
    juno_notice critical 'Bloqueio não iniciado' 'A configuração do bloqueio não está disponível. A tela não foi bloqueada.'
    exit 1
fi
temporary=$(mktemp "$JUNO_RUNTIME_DIR/.hyprlock.XXXXXX")
trap 'rm -f -- "$temporary" "$runtime_config"' EXIT
while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == '    path = # JUNO_WALLPAPER' ]]; then
        printf '    path = %s\n' "$wallpaper"
    else
        printf '%s\n' "$line"
    fi
done < "$template" > "$temporary"
mv -f -- "$temporary" "$runtime_config"

if ! hyprlock --no-fade-in --config "$runtime_config"; then
    juno_notice critical 'Bloqueio não iniciado' 'A tela não foi bloqueada. Consulte o log da sessão antes de se afastar.'
    exit 1
fi
